# Source-development settings; not a deployment bundle configuration.
# See CONTRIBUTING.md. These paths match the canonical source layout.
KODI_LAB_DATA_ROOT=/var/lib/kodi-lab
KODI_LAB_RUNTIME_ROOT=/run/kodi-lab

# Native ZIP delivery is disabled until an administrator sets the Web origin.
KODI_LAB_NATIVE_ZIP_BASE_URL=

# Historical experimental viewer: one qualified Ubuntu Omega target UUID.
# Standard noVNC needs no allowlist; see docs/STANDARD-NOVNC.md.
# Set identically for Web and broker; empty by default. See docs/EXPERIMENTAL-NOVNC.md.
KODI_LAB_EXPERIMENTAL_NOVNC_INSTANCES=[]
