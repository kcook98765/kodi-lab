#!/usr/bin/env python3
"""Safely identify or remove dead Kodi Lab snapshot-test scratch roots."""

from __future__ import annotations

import argparse
import json
import os
import stat
import sys
import time
from pathlib import Path
from typing import Any

from test_scratch import OwnedScratch, process_start_ticks, sweep

PREFIX = "kodi-lab-snapshot-tests."
MARKER = ".kodi-lab-test-scratch.json"


def load_candidate(path: Path, parent: Path) -> dict[str, Any] | None:
    try:
        metadata = path.stat(follow_symlinks=False)
        marker = path / MARKER
        marker_metadata = marker.stat(follow_symlinks=False)
        owned = OwnedScratch.capture(path, parent, private_parent=False)
        fd = os.open(marker, os.O_RDONLY | os.O_NOFOLLOW | os.O_CLOEXEC | os.O_NONBLOCK)
        with os.fdopen(fd, "rb") as stream:
            opened = os.fstat(stream.fileno())
            if (
                not stat.S_ISREG(opened.st_mode)
                or opened.st_uid != os.getuid()
                or stat.S_IMODE(opened.st_mode) != 0o600
                or opened.st_nlink != 1
                or (opened.st_dev, opened.st_ino)
                != (marker_metadata.st_dev, marker_metadata.st_ino)
                or opened.st_size > 8192
            ):
                return None
            document = json.loads(stream.read(8193))
        if not isinstance(document, dict):
            return None
    except (FileNotFoundError, OSError, ValueError, json.JSONDecodeError):
        return None
    if (
        path.parent != parent
        or path.is_symlink()
        or not stat.S_ISDIR(metadata.st_mode)
        or metadata.st_uid != os.getuid()
        or stat.S_IMODE(metadata.st_mode) & 0o077
        or marker.is_symlink()
        or not stat.S_ISREG(marker_metadata.st_mode)
        or marker_metadata.st_uid != os.getuid()
        or marker_metadata.st_nlink != 1
        or stat.S_IMODE(marker_metadata.st_mode) != 0o600
        or document.get("schema") != 1
        or document.get("kind") != "kodi-lab-snapshot-test-scratch"
        or document.get("uid") != os.getuid()
        or document.get("root") != str(path)
        or type(document.get("pid")) is not int
        or document["pid"] <= 0
        or type(document.get("process_start_ticks")) is not int
        or document["process_start_ticks"] <= 0
    ):
        return None
    document["_owned"] = owned
    return document


def main() -> int:
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument(
        "--parent",
        type=Path,
        default=Path(os.environ.get("KODI_LAB_TEST_SNAPSHOT_SCRATCH_PARENT", "/tmp")),
    )
    parser.add_argument("--minimum-age-seconds", type=int, default=3600)
    parser.add_argument(
        "--delete",
        action="store_true",
        help="remove validated dead roots; the default is a dry run",
    )
    args = parser.parse_args()
    parent = args.parent
    if (
        not parent.is_absolute()
        or parent.is_symlink()
        or not parent.is_dir()
        or args.minimum_age_seconds < 0
    ):
        parser.error("parent and minimum age must be safe")

    found, removed = sweep(parent, args.minimum_age_seconds, delete=args.delete)
    now = time.time()
    for path in sorted(parent.glob(f"{PREFIX}*")):
        document = load_candidate(path, parent)
        if document is None:
            if (path / ".kodi-lab-run-scratch.json").exists():
                continue
            print(f"skip unvalidated: {path}", file=sys.stderr)
            continue
        age = now - path.stat(follow_symlinks=False).st_mtime
        pid = document["pid"]
        try:
            live = process_start_ticks(pid) == document["process_start_ticks"]
        except (OSError, ValueError):
            print(f"skip unknown owner state: {path}", file=sys.stderr)
            continue
        if live:
            print(f"skip live pid {pid}: {path}")
            continue
        if age < args.minimum_age_seconds:
            print(f"skip age {age:.0f}s: {path}")
            continue
        found += 1
        if args.delete:
            try:
                document["_owned"].remove()
            except (OSError, ValueError):
                print(f"retained inaccessible: {path}", file=sys.stderr)
                continue
            removed += 1
            print(f"removed: {path}")
        else:
            print(f"dead candidate: {path}")
    print(f"validated dead roots: {found}; removed: {removed}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
