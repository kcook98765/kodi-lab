#!/usr/bin/env bash

set -euo pipefail

if (( EUID == 0 )); then
    echo "Kodi Lab development checks must be run as a non-root user." >&2
    exit 1
fi

repo_root="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)"
cd -- "$repo_root"

pytest_tmp_parent="${TMPDIR:-/tmp}"
if [[ -d /dev/shm && -w /dev/shm ]] \
    && [[ "$(stat -f -c %T /dev/shm)" == "tmpfs" ]] \
    && (( $(df -B1 --output=avail /dev/shm | tail -n 1) >= 1073741824 )); then
    pytest_tmp_parent="/dev/shm"
fi
pytest_root="$(mktemp -d --tmpdir="$pytest_tmp_parent" klp.XXXXXXXX)"
scratch_token="$(python3 scripts/test_scratch.py capture "$pytest_root" --owner-pid "$$")"
pytest_tmpdir="$pytest_root/pytest"
cleanup() {
    local status=$?
    if ! python3 scripts/test_scratch.py remove "$scratch_token"; then
        if (( status == 0 )); then status=1; fi
    fi
    exit "$status"
}
trap cleanup EXIT

run_check() {
    local name="$1"
    shift
    printf '\n==> %s\n' "$name"
    "$@"
}

# Keep this list explicit and deliberately representative. The broader fast and
# full gates remain responsible for integration, lifecycle, and migration depth.
smoke_tests=(
    tests/domain
    tests/application/test_activity.py
    tests/application/test_development_source_service.py
    tests/application/test_development_source_smoke_tests.py
    tests/application/test_runtime_execution_profile.py
    tests/application/test_runtime_eligibility.py
    tests/application/test_runtime_matrix.py
    tests/development
    tests/kodi/test_kodi_addon_smoke_adapter.py
    tests/runtime/test_curated_catalog.py
    tests/runtime/test_manifest.py
    tests/snapshot/test_deletion.py
    tests/snapshot/test_restore_validation.py
    tests/storage/test_development_source_attachment_repository.py
    tests/storage/test_development_source_repository.py
    tests/storage/test_repositories.py
    tests/storage/test_runtime_catalog_repositories.py
    tests/auth/test_web_auth.py
    tests/web/test_runtime_matrix.py
    tests/web/test_development_source_smoke_tests.py
    tests/web/test_security_boundary.py
)

run_check "Ruff format" uv run --locked ruff format --check .
run_check "Ruff lint" uv run --locked ruff check .
run_check "mypy" uv run --locked mypy src tests migrations
run_check \
    "pytest (smoke core)" \
    uv run --locked pytest --basetemp "$pytest_tmpdir" "${smoke_tests[@]}"

printf '\nSmoke checks passed. Select the next validation level in CONTRIBUTING.md.\n'
