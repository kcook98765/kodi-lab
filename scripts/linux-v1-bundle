#!/usr/bin/env python3
"""Stage and verify the binary-free Kodi Lab Linux V1 inventory."""

from __future__ import annotations

import argparse
import hashlib
import json
import os
import pathlib
import re
import subprocess
import sys
import tarfile
import tomllib

APP_ARCHIVE = "kodi-lab-application-images.tar"
RECIPES = {
    "matrix": "matrix-19.4-r1.json",
    "nexus": "nexus-20.5-r1.json",
    "omega": "omega-21.3-r1.json",
}
RELEASE_FILES = {
    APP_ARCHIVE,
    ".env.example",
    "compose.release.yaml",
    "compose.lab.yaml",
    "compose.development.yaml",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "INSTALL.md",
    "RELEASE.md",
    "UPGRADE-ROLLBACK.md",
    "MANAGED-STATE-RECOVERY.md",
    "linux-v1-bundle",
} | {f"runtime-recipes/{name}" for name in RECIPES.values()}
HEX = re.compile(r"sha256:[0-9a-f]{64}\Z")
TREE = re.compile(r"[0-9a-f]{40}\Z")
DEVELOPMENT_SOURCE_KEY = "KODI_LAB_DEVELOPMENT_SOURCE"


def development_source_path(value: str, *, require_directory: bool) -> pathlib.Path:
    """Accept a canonical host directory representable in Compose dotenv syntax."""

    if (
        not value.startswith("/")
        or value == "/"
        or os.path.normpath(value) != value
        or any(ord(character) < 32 or character in "'\"$#\\" for character in value)
    ):
        raise ValueError(
            "development source must be a normalized absolute non-root path "
            "without dotenv metacharacters"
        )
    path = pathlib.Path(value)
    if require_directory:
        flags = os.O_RDONLY | os.O_DIRECTORY | os.O_CLOEXEC | os.O_NOFOLLOW
        current = os.open("/", flags)
        try:
            for part in path.parts[1:]:
                following = os.open(part, flags, dir_fd=current)
                os.close(current)
                current = following
        finally:
            os.close(current)
    return path


def local_environment(
    bundle: pathlib.Path, *, require_development_directory: bool = True
) -> dict[str, str]:
    lines = (bundle / ".env").read_text().splitlines()
    values: dict[str, str] = {}
    for line in lines:
        if "=" not in line:
            raise ValueError("local environment is malformed")
        key, value = line.split("=", 1)
        if key in values:
            raise ValueError("local environment has duplicate keys")
        values[key] = value
    if DEVELOPMENT_SOURCE_KEY in values:
        quoted = values[DEVELOPMENT_SOURCE_KEY]
        if not (quoted.startswith("'") and quoted.endswith("'")):
            raise ValueError("development source must use single-quoted dotenv syntax")
        development_source_path(
            quoted[1:-1], require_directory=require_development_directory
        )
    return values


def digest(path: pathlib.Path) -> str:
    with path.open("rb") as stream:
        return "sha256:" + hashlib.file_digest(stream, "sha256").hexdigest()


def canonical(data: object) -> bytes:
    return (json.dumps(data, sort_keys=True, separators=(",", ":")) + "\n").encode()


def archive_images(path: pathlib.Path) -> tuple[dict[str, str], set[str]]:
    """Get each saved tag's immutable OCI config digest from tar bytes."""
    with tarfile.open(path, "r:") as archive:
        member = archive.extractfile("manifest.json")
        if member is None:
            raise ValueError("archive has no Docker manifest")
        entries = json.load(member)
        if not isinstance(entries, list):
            raise ValueError("archive manifest is invalid")
        result: dict[str, str] = {}
        config_ids: set[str] = set()
        for entry in entries:
            config = entry["Config"]
            if not re.fullmatch(r"blobs/sha256/[0-9a-f]{64}", config):
                raise ValueError("archive config path is invalid")
            config_bytes = archive.extractfile(config)
            if config_bytes is None:
                raise ValueError("archive config is absent")
            actual = "sha256:" + hashlib.sha256(config_bytes.read()).hexdigest()
            if actual != "sha256:" + config.rsplit("/", 1)[1]:
                raise ValueError("archive config digest differs")
            config_ids.add(actual)
            for tag in entry.get("RepoTags") or []:
                if tag in result:
                    raise ValueError("duplicate archive tag")
                result[tag] = actual
        return result, config_ids


def archive_contains_digest(path: pathlib.Path, identity: str) -> bool:
    if not HEX.fullmatch(identity):
        return False
    with tarfile.open(path, "r:") as archive:
        member = archive.extractfile("blobs/sha256/" + identity.removeprefix("sha256:"))
        return (
            member is not None
            and "sha256:" + hashlib.sha256(member.read()).hexdigest() == identity
        )


def _file_record(path: pathlib.Path) -> dict[str, str | int]:
    if not path.is_file() or path.is_symlink():
        raise ValueError(f"missing or unsafe artifact: {path.name}")
    return {"sha256": digest(path), "size": path.stat().st_size}


def _inventory(bundle: pathlib.Path) -> set[str]:
    if any(p.is_symlink() for p in bundle.rglob("*")):
        raise ValueError("bundle contains a symlink")
    return {p.relative_to(bundle).as_posix() for p in bundle.rglob("*") if p.is_file()}


def _recipe_record(path: pathlib.Path) -> dict[str, str | int]:
    recipe = json.loads(path.read_bytes())
    if (
        recipe.get("generation") not in RECIPES
        or recipe.get("platform") != "linux/amd64"
        or recipe.get("provider", {}).get("type") != "signed_distro_apt"
        or recipe.get("recipe_revision") != 1
    ):
        raise ValueError("release recipe identity differs")
    return {
        "generation": recipe["generation"],
        "release": recipe["kodi_version"],
        "recipe_id": recipe["recipe_id"],
        "recipe_revision": recipe["recipe_revision"],
        "recipe_digest": digest(path),
        "provider": recipe["provider"]["distribution"],
        "suite": recipe["provider"]["suite"],
        "file": path.relative_to(path.parent.parent).as_posix(),
    }


def _recipes(bundle: pathlib.Path) -> list[dict[str, str | int]]:
    result = []
    for generation, filename in RECIPES.items():
        item = _recipe_record(bundle / "runtime-recipes" / filename)
        if item["generation"] != generation:
            raise ValueError("release recipe generation differs")
        result.append(item)
    if [(item["release"], item["suite"]) for item in result] != [
        ("19.4", "jammy"),
        ("20.5", "noble"),
        ("21.3", "resolute"),
    ]:
        raise ValueError("release recipe set differs")
    return result


def finalize(bundle: pathlib.Path, repository: pathlib.Path) -> None:
    version = tomllib.loads((repository / "pyproject.toml").read_text())["project"][
        "version"
    ]
    source_tree = subprocess.check_output(
        ["git", "-C", str(repository), "write-tree"], text=True
    ).strip()
    if (
        not TREE.fullmatch(source_tree)
        or subprocess.run(
            ["git", "-C", str(repository), "diff", "--quiet"], check=False
        ).returncode
    ):
        raise ValueError("release source differs from staged Git tree")
    if _inventory(bundle) != RELEASE_FILES:
        raise ValueError("release file inventory differs")
    tags = {role: f"kodi-lab-v1-{role}:{version}" for role in ("web", "broker")}
    configs, _ = archive_images(bundle / APP_ARCHIVE)
    if set(configs) != set(tags.values()):
        raise ValueError("application archive tags differ from release roles")
    images = {}
    package_identities = set()
    for role, tag in tags.items():
        inspected = (
            subprocess.check_output(
                [
                    "docker",
                    "image",
                    "inspect",
                    "--format",
                    "{{.Id}} {{.Os}}/{{.Architecture}}",
                    tag,
                ],
                text=True,
            )
            .strip()
            .split()
        )
        if (
            len(inspected) != 2
            or not HEX.fullmatch(inspected[0])
            or inspected[1] != "linux/amd64"
        ):
            raise ValueError("application build image has wrong identity or platform")
        labels = json.loads(
            subprocess.check_output(
                [
                    "docker",
                    "image",
                    "inspect",
                    "--format",
                    "{{json .Config.Labels}}",
                    tag,
                ],
                text=True,
            )
        )
        if (
            labels.get("org.opencontainers.image.revision") != source_tree
            or labels.get("org.opencontainers.image.version") != version
        ):
            raise ValueError("application build labels differ from staged source")
        package_identity = subprocess.check_output(
            [
                "docker",
                "run",
                "--rm",
                "--network",
                "none",
                "--entrypoint",
                "kodi-lab-admin",
                tag,
                "version",
            ],
            text=True,
        ).strip()
        if not re.fullmatch(
            rf"Kodi Lab {re.escape(version)} package-sha256=[0-9a-f]{{64}}",
            package_identity,
        ):
            raise ValueError("installed application package identity differs")
        package_identities.add(package_identity)
        images[role] = {
            "saved_image_id": inspected[0],
            "config_image_id": configs[tag],
            "tag_hint": tag,
        }
    if len(package_identities) != 1:
        raise ValueError("Web and broker have different installed package bytes")
    recipes = _recipes(bundle)
    installed_recipes = json.loads(
        subprocess.check_output(
            [
                "docker",
                "run",
                "--rm",
                "--network",
                "none",
                "--entrypoint",
                "python",
                tags["broker"],
                "-c",
                "import json; from kodi_lab.runtime.recipes import "
                "load_reviewed_recipe, supported_generations; "
                "print(json.dumps({g:load_reviewed_recipe(g).digest "
                "for g in supported_generations()}))",
            ],
            text=True,
        )
    )
    if installed_recipes != {
        item["generation"]: item["recipe_digest"] for item in recipes
    }:
        raise ValueError("bundle recipes differ from installed wheel")
    files = {name: _file_record(bundle / name) for name in sorted(RELEASE_FILES)}
    manifest = {
        "schema": "kodi-lab-linux-v1-bundle-v2",
        "version": version,
        "source_tree": source_tree,
        "platform": "linux/amd64",
        "build": {
            "process": "Docker multi-stage wheel build using pinned base and uv.lock",
            "dockerfile_sha256": digest(repository / "runtime/remote-web/Dockerfile"),
            "lock_sha256": digest(repository / "uv.lock"),
            "reproducible_build_claim": False,
        },
        "application": {
            "archive": APP_ARCHIVE,
            "installed_package_identity": package_identities.pop(),
            "images": images,
        },
        "runtimes": recipes,
        "files": files,
    }
    (bundle / "BUNDLE.json").write_bytes(canonical(manifest))
    (bundle / "SHA256SUMS").write_text(
        "".join(
            f"{digest(bundle / name).removeprefix('sha256:')}  {name}\n"
            for name in sorted((*RELEASE_FILES, "BUNDLE.json"))
        )
    )


def verify(bundle: pathlib.Path, *, require_development_directory: bool = True) -> dict:
    data = json.loads((bundle / "BUNDLE.json").read_bytes())
    if (
        data.get("schema") != "kodi-lab-linux-v1-bundle-v2"
        or data.get("platform") != "linux/amd64"
        or not isinstance(data.get("source_tree"), str)
        or not TREE.fullmatch(data["source_tree"])
        or set(data.get("files", {})) != RELEASE_FILES
    ):
        raise ValueError("unsupported bundle manifest or inventory")
    if canonical(data) != (bundle / "BUNDLE.json").read_bytes():
        raise ValueError("bundle manifest is not canonical")
    observed_names = _inventory(bundle)
    if observed_names != RELEASE_FILES | {"BUNDLE.json", "SHA256SUMS"} | (
        {".env"} if (bundle / ".env").is_file() else set()
    ):
        raise ValueError("bundle file inventory differs")
    for name, record in data["files"].items():
        if _file_record(bundle / name) != record:
            raise ValueError(f"artifact differs: {name}")
    expected_sums = "".join(
        f"{digest(bundle / name).removeprefix('sha256:')}  {name}\n"
        for name in sorted((*RELEASE_FILES, "BUNDLE.json"))
    )
    if (bundle / "SHA256SUMS").read_text() != expected_sums:
        raise ValueError("checksum inventory differs")
    app = data["application"]
    configs, _ = archive_images(bundle / app["archive"])
    if configs != {
        value["tag_hint"]: value["config_image_id"] for value in app["images"].values()
    } or set(app["images"]) != {"web", "broker"}:
        raise ValueError("application archive image identities differ")
    if any(
        not archive_contains_digest(bundle / app["archive"], value["saved_image_id"])
        for value in app["images"].values()
    ):
        raise ValueError("saved application image identity is absent from archive")
    if data["runtimes"] != _recipes(bundle):
        raise ValueError("reviewed recipe metadata differs")
    env_path = bundle / ".env"
    if env_path.exists():
        values = local_environment(
            bundle, require_development_directory=require_development_directory
        )
        expected_keys = {
            "KODI_LAB_REMOTE_IMAGE": app["images"]["web"],
            "KODI_LAB_BROKER_IMAGE": app["images"]["broker"],
        }
        if (
            set(values)
            not in (
                set(expected_keys) | {"KODI_LAB_PUBLISHED_PORT"},
                set(expected_keys)
                | {"KODI_LAB_PUBLISHED_PORT", DEVELOPMENT_SOURCE_KEY},
            )
            or any(
                values[key] not in {item["saved_image_id"], item["config_image_id"]}
                for key, item in expected_keys.items()
            )
            or not values["KODI_LAB_PUBLISHED_PORT"].isdigit()
            or not 1 <= int(values["KODI_LAB_PUBLISHED_PORT"]) <= 65535
        ):
            raise ValueError("local image selection differs from reviewed bundle")
    return data


def configure(bundle: pathlib.Path, data: dict, port: int) -> None:
    if (bundle / ".env").exists() or not 1 <= port <= 65535:
        raise ValueError(".env already exists or port is invalid")
    chosen = {}
    for role, item in data["application"]["images"].items():
        for candidate in (item["saved_image_id"], item["config_image_id"]):
            result = subprocess.run(
                [
                    "docker",
                    "image",
                    "inspect",
                    "--format",
                    "{{.Id}} {{.Os}}/{{.Architecture}}",
                    candidate,
                ],
                text=True,
                capture_output=True,
            )
            if (
                result.returncode == 0
                and result.stdout.strip() == f"{candidate} linux/amd64"
            ):
                chosen[role] = candidate
                break
        else:
            raise ValueError(f"verified {role} image is not loaded for linux/amd64")
    (bundle / ".env").write_text(
        f"KODI_LAB_REMOTE_IMAGE={chosen['web']}\n"
        f"KODI_LAB_BROKER_IMAGE={chosen['broker']}\n"
        f"KODI_LAB_PUBLISHED_PORT={port}\n"
    )
    print("configured exact application image IDs for this Docker Engine")


def configure_development_source(bundle: pathlib.Path, source: str) -> None:
    development_source_path(source, require_directory=True)
    values = local_environment(bundle, require_development_directory=False)
    values[DEVELOPMENT_SOURCE_KEY] = f"'{source}'"
    (bundle / ".env").write_text(
        "".join(f"{key}={value}\n" for key, value in values.items())
    )
    print("configured one local development source directory")


def main() -> int:
    parser = argparse.ArgumentParser()
    parser.add_argument(
        "command", choices=("finalize", "verify", "configure", "development-source")
    )
    parser.add_argument("bundle", type=pathlib.Path)
    parser.add_argument("repository", type=pathlib.Path, nargs="?")
    parser.add_argument("--port", type=int, default=18100)
    parser.add_argument("--source")
    args = parser.parse_args()
    try:
        if args.command == "finalize":
            if args.repository is None:
                raise ValueError("finalize requires repository")
            finalize(args.bundle, args.repository)
        else:
            data = verify(
                args.bundle,
                require_development_directory=args.command != "development-source",
            )
            if args.command == "configure":
                configure(args.bundle, data, args.port)
            elif args.command == "development-source":
                if args.source is None or not (args.bundle / ".env").exists():
                    raise ValueError(
                        "development-source needs --source and configured .env"
                    )
                configure_development_source(args.bundle, args.source)
            else:
                print(
                    f"verified Kodi Lab {data['version']} bundle for {data['platform']}"
                )
    except (
        OSError,
        ValueError,
        KeyError,
        TypeError,
        tarfile.TarError,
        json.JSONDecodeError,
    ) as error:
        print(f"bundle {args.command} failed: {error}", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
