#!/usr/bin/env bash
# Local deployment-candidate staging. No upload, tag publication, or Docker load.
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "usage: $0 EMPTY_OUTPUT_DIRECTORY" >&2
  exit 2
fi

repository=$(cd "$(dirname "$0")/.." && pwd -P)
output=$(realpath -m "$1")
version=$(python3 - "$repository/pyproject.toml" <<'PY'
import pathlib
import sys
import tomllib
print(tomllib.loads(pathlib.Path(sys.argv[1]).read_text())["project"]["version"])
PY
)
if [[ -n "$(git -C "$repository" status --porcelain)" ]]; then
  echo "deployment candidate source must be a clean commit" >&2
  exit 2
fi
source_tree=$(git -C "$repository" rev-parse 'HEAD^{tree}')
if [[ -e "$output" ]] && [[ -n "$(ls -A "$output")" ]]; then
  echo "output directory must be empty" >&2
  exit 2
fi
mkdir -p "$output"
mkdir "$output/bridge"
mkdir "$output/repository"
cp "$repository/repository/STABLE.json" "$output/repository/STABLE.json"
cp "$repository/repository/DEVELOPMENT.json" "$output/repository/DEVELOPMENT.json"
python3 "$repository/scripts/build_narrow_bridge.py" \
  --output "$output/bridge/service.kodi_lab_bridge-1.1.13.zip" \
  --provenance "$output/bridge/BRIDGE.json"

build_network=${KODI_LAB_BUNDLE_BUILD_NETWORK:-default}
docker build --network "$build_network" --provenance=false --quiet --target web \
  --build-arg "KODI_LAB_SOURCE_TREE=$source_tree" \
  --build-arg "KODI_LAB_RELEASE_VERSION=$version" \
  -t "kodi-lab-v1-web:$version" -f "$repository/runtime/remote-web/Dockerfile" \
  "$repository"
docker build --network "$build_network" --provenance=false --quiet --target broker \
  --build-arg "KODI_LAB_SOURCE_TREE=$source_tree" \
  --build-arg "KODI_LAB_RELEASE_VERSION=$version" \
  -t "kodi-lab-v1-broker:$version" -f "$repository/runtime/remote-web/Dockerfile" \
  "$repository"
docker save --output "$output/kodi-lab-application-images.tar" \
  "kodi-lab-v1-web:$version" "kodi-lab-v1-broker:$version"
cp "$repository/compose.release.yaml" "$repository/compose.lab.yaml" \
  "$repository/compose.development.yaml" "$output/"
cp "$repository/LICENSE" "$repository/THIRD_PARTY_NOTICES.md" "$output/"
cp "$repository/docs/LINUX-V1-INSTALL.md" "$output/INSTALL.md"
cp "$repository/docs/LINUX-V1-UPGRADE-ROLLBACK.md" \
  "$output/UPGRADE-ROLLBACK.md"
cp "$repository/docs/MANAGED-STATE-RECOVERY.md" \
  "$output/MANAGED-STATE-RECOVERY.md"
cp "$repository/docs/PRODUCTION-OPERATIONS.md" "$output/PRODUCTION-OPERATIONS.md"
cp "$repository/docs/LINUX-V1-RELEASE.md" \
  "$output/RELEASE.md"
cp "$repository/scripts/linux-v1-bundle" "$output/linux-v1-bundle"
mkdir "$output/runtime-recipes"
cp "$repository"/src/kodi_lab/runtime/recipes/{matrix-19.4-r1,nexus-20.5-r1,omega-21.3-r1}.json \
  "$output/runtime-recipes/"
cat > "$output/.env.example" <<'EOF'
# Run python3 linux-v1-bundle configure . --repository-bind PRIVATE_LAN_IP
#   --repository-port PORT --repository-base-url http://DURABLE_LAN_HOST:PORT
# after loading the application archive.
# The generated .env pins image IDs recognized on this Docker Engine.
KODI_LAB_PUBLISHED_PORT=18100
# There is no default LAN bind or public URL. Choose both explicitly.
# Optional: run `python3 linux-v1-bundle development-source . --source /absolute/path`
# to add the host source directory, then include compose.development.yaml.
# Example host path (not required): /srv/kodi-lab/addon-sources
EOF
python3 "$repository/scripts/linux-v1-bundle" finalize "$output" "$repository"
python3 "$repository/scripts/linux-v1-bundle" verify "$output"
echo "Local Linux V1 deployment candidate staged in $output"
