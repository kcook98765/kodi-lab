#!/usr/bin/env bash
# Local release-candidate staging. No upload, tag publication, or Docker load.
set -euo pipefail

if [[ $# -ne 2 ]]; then
  echo "usage: $0 REVIEWED_ARCHIVE_DIRECTORY EMPTY_OUTPUT_DIRECTORY" >&2
  exit 2
fi

repository=$(cd "$(dirname "$0")/.." && pwd -P)
archives=$(realpath "$1")
output=$(realpath -m "$2")
if [[ ! -d "$archives" ]]; then
  echo "reviewed archive directory is missing" >&2
  exit 2
fi
if [[ -e "$output" ]] && [[ -n "$(ls -A "$output")" ]]; then
  echo "output directory must be empty" >&2
  exit 2
fi
mkdir -p "$output"

for name in kodi-19.5 kodi-20.5 kodi-21.3 kodi-22.0-beta2; do
  python3 - "$repository/src/kodi_lab/runtime/catalog/$name.json" "$archives/$name.tar" <<'PY'
import hashlib
import json
import pathlib
import sys

manifest = json.loads(pathlib.Path(sys.argv[1]).read_text())
archive = pathlib.Path(sys.argv[2])
expected = manifest["distribution"]
if not archive.is_file() or archive.is_symlink():
    raise SystemExit(f"reviewed archive is missing or unsafe: {archive.name}")
if archive.stat().st_size != expected["archive_size"]:
    raise SystemExit(f"reviewed archive size differs: {archive.name}")
digest = hashlib.file_digest(archive.open("rb"), "sha256").hexdigest()
if f"sha256:{digest}" != expected["archive_digest"]:
    raise SystemExit(f"reviewed archive hash differs: {archive.name}")
print(f"verified {archive.name}")
PY
  cp --reflink=auto "$archives/$name.tar" "$output/$name.tar"
done

build_network=${KODI_LAB_BUNDLE_BUILD_NETWORK:-default}
docker build --network "$build_network" --quiet --target web \
  -t kodi-lab-rc-web:local -f "$repository/runtime/remote-web/Dockerfile" \
  "$repository"
docker build --network "$build_network" --quiet --target broker \
  -t kodi-lab-rc-broker:local -f "$repository/runtime/remote-web/Dockerfile" \
  "$repository"
docker save --output "$output/kodi-lab-application-images.tar" \
  kodi-lab-rc-web:local kodi-lab-rc-broker:local
docker image inspect --format '{{.Id}} {{.Os}}/{{.Architecture}}' \
  kodi-lab-rc-web:local kodi-lab-rc-broker:local > "$output/APPLICATION-IMAGE-IDS"

cp "$repository/compose.release.yaml" "$repository/compose.lab.yaml" "$output/"
cp "$repository/docs/LINUX-V1-INSTALL.md" "$output/INSTALL.md"
cp "$repository/docs/KODI-VERSION-EXTENSIBILITY.md" \
  "$output/KODI-VERSION-EXTENSIBILITY.md"
cp "$repository/docs/CURATED-IMAGE-DISTRIBUTION.md" \
  "$output/CURATED-IMAGE-DISTRIBUTION.md"
cp "$repository/docs/LINUX-V1-UPGRADE-ROLLBACK.md" \
  "$output/UPGRADE-ROLLBACK.md"
cp "$repository/docs/MANAGED-STATE-RECOVERY.md" \
  "$output/MANAGED-STATE-RECOVERY.md"
cat > "$output/.env.example" <<'EOF'
KODI_LAB_REMOTE_IMAGE=kodi-lab-rc-web:local
KODI_LAB_BROKER_IMAGE=kodi-lab-rc-broker:local
KODI_LAB_PUBLISHED_PORT=18100
EOF
(
  cd "$output"
  sha256sum .env.example APPLICATION-IMAGE-IDS INSTALL.md \
    KODI-VERSION-EXTENSIBILITY.md CURATED-IMAGE-DISTRIBUTION.md \
    UPGRADE-ROLLBACK.md MANAGED-STATE-RECOVERY.md \
    compose.release.yaml compose.lab.yaml \
    kodi-lab-application-images.tar kodi-19.5.tar kodi-20.5.tar \
    kodi-21.3.tar kodi-22.0-beta2.tar > SHA256SUMS
)
echo "Local Linux V1 candidate staged in $output"
